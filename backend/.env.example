# ============================================================
# Dental Imperador — Backend Environment Example
# Copie este arquivo para .env e preencha os valores reais.
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Banco de Dados (SQLite para dev, PostgreSQL para prod)
DATABASE_URL="file:./dev.db"

# Redis (opcional — fallback para cache in-memory)
REDIS_URL="redis://localhost:6379"

# Firebase Admin
# Baixar JSON do Firebase Console > Contas de Serviço > Gerar nova chave
# Salvar como: backend/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Groq API (Chat IA)
GROQ_API_KEY=gsk_seu_token_aqui

# ERP FlexTotal
FLEXTOTAL_BASE_URL=https://portal.dentalimperador.com.br:9090/flextotal/ws/integracao
FLEXTOTAL_AUTH_HEADER=Flexmobile_API SEU_TOKEN_AQUI
FLEXTOTAL_COOKIE=XSRF-TOKEN=seu_token; access_token=seu_jwt
FLEXTOTAL_SYNC_ENABLED=false
FLEXTOTAL_SYNC_INTERVAL=1800000

# SendGrid (campanhas de retenção)
SENDGRID_API_KEY=SG.seu_token_aqui

# Twilio (WhatsApp - opcional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
