# ============================================================
# Dental Imperador — Variáveis de Ambiente (Root)
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env real no repositório.
#
# Configurações específicas do backend estão em backend/.env
# Configurações do frontend são injetadas via Vite (VITE_*)
# GROQ_API_KEY é configurada no Firebase Console (Functions > Secrets)
# ============================================================

# --- Firebase (Frontend - Vite) ---
# Já hardcoded no firebase.ts (firebaseConfig)
# Não requer variáveis de ambiente no frontend para este projeto

# --- Deploy ---
DEPLOY_DOMAIN=dentalimperador.web.app
