rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // REGRAS GLOBAIS
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =============================================
    // USUÁRIOS
    // =============================================
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update, delete: if isAdmin();
    }

    // =============================================
    // CONVERSAS DE CHAT (público - chatbot anônimo)
    // =============================================
    match /conversations/{convId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // =============================================
    // PRODUTOS (leitura publica, escrita admin)
    // =============================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =============================================
    // PEDIDOS
    // =============================================
    match /orders/{orderId} {
      allow read: if isAuthenticated()
        && (resource.data.cliente_uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =============================================
    // NEGAR PADRAO
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
