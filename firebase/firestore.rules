rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // REGRAS GLOBAIS
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =============================================
    // USUÁRIOS
    // =============================================
    match /users/{userId} {
      // Admins podem ler todos os usuarios
      // O proprio usuario pode ler seus proprios dados
      allow read: if isAdmin() || isOwner(userId);
      // Apenas admin pode criar/atualizar/deletar
      allow create, update, delete: if isAdmin();
    }

    // =============================================
    // CONVERSAS DE CHAT
    // =============================================
    match /conversations/{convId} {
      // Participantes da conversa e admins podem ler
      allow read: if isAuthenticated()
        && (resource.data.participantes.hasAny([request.auth.uid]) || isAdmin());

      // Criar: qualquer usuario autenticado pode iniciar
      allow create: if isAuthenticated()
        && request.resource.data.participantes.hasAny([request.auth.uid]);

      // Atualizar: apenas participantes ou admin
      allow update: if isAuthenticated()
        && (resource.data.participantes.hasAny([request.auth.uid]) || isAdmin());

      // Deletar: apenas admin
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/conversations/$(convId)).data.participantes.hasAny([request.auth.uid])
          || isAdmin();

        allow create: if isAuthenticated()
          && request.resource.data.remetente == request.auth.uid;

        allow update, delete: if isAdmin();
      }
    }

    // =============================================
    // PRODUTOS (leitura publica, escrita admin)
    // =============================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =============================================
    // PEDIDOS
    // =============================================
    match /orders/{orderId} {
      allow read: if isAuthenticated()
        && (resource.data.cliente_uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =============================================
    // NEGAR PADRAO
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
