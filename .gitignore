# ============================================================
# Dental Imperador — .gitignore
# O site estático fica na raiz do repositório e é publicado
# no GitHub Pages (branch gh-pages) pelo workflow em .github/workflows.
# ============================================================

# SO não versiona
.DS_Store
Thumbs.db
*.log

# ============================================================
# Ambiente e segredos (NUNCA versionar)
# ============================================================

# Variáveis de ambiente
.env
.env.local
.env.production
.env.development
.env.staging

# Diretórios de ambiente virtual Python
.venv
venv/
venv.bak/

# node_modules (quando o monorepo for criado)
node_modules/
**/node_modules/

# Diretórios de build
dist/
build/
.next/

# Chave de conta de serviço Firebase (NUNCA versionar)
scripts/service-account*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# SQLite database (dev only)
*.db

# ============================================================
# Documentação interna (NUNCA versionar)
# ============================================================
docs/
